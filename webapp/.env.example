# ─── AnyDownloader Webapp — Environment Variables Reference ─────────────────
# Copy this file to .env.production before building for production.
# Never commit .env.production — it may contain publisher IDs.
#
# For server-side deployment vars (SSH host, server IP, etc.), copy this file
# to .env.prod instead — deploy.sh / docker-deploy.sh / server-deploy.sh
# all source ${SCRIPT_DIR}/.env.prod at startup.
#
# All VITE_* variables are baked into the JS bundle at build time.
# Changing them requires a rebuild and re-deploy.

# ── Deployment target (server-side, used by *-deploy.sh) ─────────────────────
# These are NEVER bundled into the frontend. They only configure the deploy
# scripts and must be set on the control host (or the server itself for
# server-deploy.sh). Leave unset when building frontend-only.

# Fully-qualified domain name that resolves to SERVER_IP via DNS / Cloudflare.
DOMAIN=your-domain.example.com

# Public IP of the origin server (Oracle Cloud / DigitalOcean / EC2 / etc.)
SERVER_IP=0.0.0.0

# SSH user + host for rsync-based deploys (remote mode only).
DEPLOY_MODE=remote              # remote | local
DEPLOY_USER=ubuntu
DEPLOY_HOST=${SERVER_IP}        # usually the same as SERVER_IP
DEPLOY_PATH=/home/ubuntu/webapp
DEPLOY_SSH_KEY=                 # optional: path to private key used by ssh/rsync

# Backend listener used by PM2 / Docker / Nginx — keep in sync with nginx.conf.
PORT=3001
FRONTEND_ORIGIN=https://${DOMAIN}

# Backend needs Node 22+, current yt-dlp (including EJS), and ffmpeg/ffprobe on PATH.
# Optional absolute yt-dlp executable path. Leave empty to use PATH/common locations.
# For pip installs: python -m pip install -U "yt-dlp[default]"
YTDLP_PATH=

# ── Connection URLs ───────────────────────────────────────────────────────────

# WebSocket URL for the download backend.
# Leave unset in production — the app auto-detects from window.location:
#   https://domain.com  →  wss://domain.com/ws  (Nginx proxies /ws)
# Set explicitly only if your backend is on a different host than the frontend.
# VITE_WS_URL=wss://yourdomain.com/ws

# Base URL prefix for /api/file/:token (one-time file download).
# Leave empty in production — relative URL goes through Nginx proxy.
# In dev, set to http://localhost:3001 to bypass Vite proxy buffering.
VITE_FILE_BASE=

# ── Advertisement configuration ───────────────────────────────────────────────

# Master switch. Set to false to hide all ad slots entirely (e.g., staging).
# Set to true to render ad slots (use AD_MODE to control what renders).
VITE_SHOW_ADS=false

# Controls what renders in each ad slot:
#   placeholder  — gray box matching real ad dimensions (for layout verification)
#   live         — real Monetag ad containers (requires zone IDs below)
VITE_AD_MODE=placeholder

# ── Monetag publisher credentials ────────────────────────────────────────────
# Obtain these from https://monetag.com → Publisher dashboard → Zones.
# Only needed when VITE_AD_MODE=live.

# Your Monetag publisher ID (used to inject the main init script)
VITE_MONETAG_PUBLISHER_ID=

# Zone IDs — create one zone per placement in the Monetag dashboard.
# Each zone type (Banner, Native, etc.) maps to a specific slot on the page.
VITE_MONETAG_ZONE_TOP_BANNER=      # Top banner bar (728×90 or responsive)
VITE_MONETAG_ZONE_SIDEBAR_L1=      # Left sidebar — upper slot (160×600)
VITE_MONETAG_ZONE_SIDEBAR_L2=      # Left sidebar — lower slot (160×600)
VITE_MONETAG_ZONE_SIDEBAR_R1=      # Right sidebar — upper slot (160×600)
VITE_MONETAG_ZONE_SIDEBAR_R2=      # Right sidebar — lower slot (160×600)
VITE_MONETAG_ZONE_BOTTOM=          # Bottom banner below content (728×90)
VITE_MONETAG_ZONE_COUNTDOWN=       # Countdown page ad (shown during 5s wait)
