{
  "manifest_version": 3,
  "name": "AnyDownloader",
  "version": "2.0.0",
  "description": "Detect videos on any page and send them to AnyDownloader desktop app for downloading",

  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications",
    "contextMenus"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AnyDownloader"
  },

  "background": {
    "service_worker": "background/service_worker.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
