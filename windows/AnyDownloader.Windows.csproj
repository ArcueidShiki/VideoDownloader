<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DebuggerSupport>false</DebuggerSupport>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AnyDownloader.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Multi-architecture support -->
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>false</SelfContained>

    <!--
      ── DEBUG: Unpackaged + self-contained runtime ────────────────────
      WindowsPackageType=None  → unpackaged; no MSIX registration needed.
      WindowsAppSDKSelfContained=true → the Windows App Runtime DLLs are
        copied next to the exe at build time (by VS/MSBuild).
        Bootstrap.Initialize() finds them immediately — no system-wide
        runtime install, no winget, no UAC prompt, works on any Win10/11.
      DISABLE_XAML_GENERATED_MAIN → our Program.cs owns the entry point.
      Build and run from Visual Studio (F5), not `dotnet run`.
      ─────────────────────────────────────────────────────────────────── -->
    <WindowsPackageType Condition="'$(Configuration)' == 'Debug'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(Configuration)' == 'Debug'">true</WindowsAppSDKSelfContained>
    <!-- Suppress the XAML-generated Program.Main in both configurations so our
         custom Program.cs is the sole entry point. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!--
      ── RELEASE: MSIX-packaged ────────────────────────────────────────
      Full MSIX pipeline for distribution (.msix / .msi / setup.exe).
      Requires a code-signing certificate or Developer Mode on the machine.
      ─────────────────────────────────────────────────────────────────── -->
    <EnableMsixTooling Condition="'$(Configuration)' == 'Release'">true</EnableMsixTooling>

    <!-- Package identity (used by MSIX) -->
    <ApplicationDisplayVersion>1.1.1</ApplicationDisplayVersion>
    <Version>1.1.1</Version>
    <ApplicationVersion>1</ApplicationVersion>
    <StartupObject>AnyDownloader.Windows.Program</StartupObject>
  </PropertyGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240311000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

  <!-- App icons — copied to output so AppIconService can read them at runtime -->
  <ItemGroup>
    <Content Include="icons\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ══════════════════════════════════════════════════════════════
       Embedded tool binaries (yt-dlp, ffmpeg, ffprobe, aria2c)
       Place the actual .exe files in the tools\ subfolder.
       They are copied to the output directory and picked up by
       BinaryResolver at runtime.
       ══════════════════════════════════════════════════════════════ -->
  <ItemGroup>
    <Content Include="DEPENDENCY-UPDATES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="tools\yt-dlp.exe" Condition="Exists('tools\yt-dlp.exe')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="tools\ffmpeg.exe" Condition="Exists('tools\ffmpeg.exe')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="tools\ffprobe.exe" Condition="Exists('tools\ffprobe.exe')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="tools\aria2c.exe" Condition="Exists('tools\aria2c.exe')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="tools\deno.exe" Condition="Exists('tools\deno.exe')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="tools\licenses\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="tools\README.txt" Condition="Exists('tools\README.txt')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Exclude the Tests\ subfolder from the main app's compile glob -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Remove="Tests\**\*" />
  </ItemGroup>

  <!-- Expose internals to the test project -->
  <ItemGroup>
    <InternalsVisibleTo Include="AnyDownloader.Windows.Tests" />
  </ItemGroup>

  <!-- MSIX visual assets — included only for packaged (MSIX) builds -->
  <ItemGroup Condition="'$(WindowsPackageType)' != 'None' and '$(WindowsPackageType)' != ''">
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- MSIX packaging manifest — only when explicitly opted into MSIX packaging
       (WindowsPackageType != None). With WindowsPackageType=None (unpackaged /
       dotnet-publish mode) this block is skipped to avoid the "AppxManifest
       specified but packaging is disabled" build error. -->
  <ItemGroup Condition="'$(WindowsPackageType)' != 'None' and '$(WindowsPackageType)' != ''">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

</Project>
