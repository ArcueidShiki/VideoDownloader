<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="AnyDownloader"
           Manufacturer="AnyDownloader"
           Version="1.0.0"
           UpgradeCode="8273A615-3276-4E24-B513-81702C1ABC98"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="AnyDownloader" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ToolComponents" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="AnyDownloader" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AnyDownloader" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="*">
        <File Id="MainExeFile"
              Source="..\publish\$(var.Arch)\AnyDownloader.Windows.exe"
              KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Name="AnyDownloader"
                    WorkingDirectory="INSTALLFOLDER"
                    Directory="ApplicationProgramsFolder"
                    Advertise="yes" />
          <Shortcut Id="DesktopShortcut"
                    Name="AnyDownloader"
                    WorkingDirectory="INSTALLFOLDER"
                    Directory="DesktopFolder"
                    Advertise="yes" />
        </File>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ToolComponents" Directory="INSTALLFOLDER">
      <Component Id="YtDlp"   Guid="*"><File Source="..\publish\$(var.Arch)\yt-dlp.exe"  /></Component>
      <Component Id="Ffmpeg"  Guid="*"><File Source="..\publish\$(var.Arch)\ffmpeg.exe"  /></Component>
      <Component Id="Ffprobe" Guid="*"><File Source="..\publish\$(var.Arch)\ffprobe.exe" /></Component>
      <Component Id="Aria2c"  Guid="*"><File Source="..\publish\$(var.Arch)\aria2c.exe"  /></Component>
    </ComponentGroup>
  </Fragment>
</Wix>
