<Window x:Class="AnyDownloader.Desktop.DownloadConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Download"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Download Details" 
                   FontSize="18" 
                   FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

        <!-- Info Section -->
        <Border Grid.Row="1" 
                Background="#F5F5F5" 
                CornerRadius="8" 
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Name:" FontWeight="SemiBold" Foreground="#666" FontSize="12"/>
                    <TextBlock x:Name="FileNameText" 
                               Text="Unknown" 
                               TextWrapping="Wrap"
                               FontSize="14"/>
                </StackPanel>
                
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Type:" FontWeight="SemiBold" Foreground="#666" FontSize="12"/>
                    <TextBlock x:Name="FileTypeText" 
                               Text="HTTP Download" 
                               FontSize="14"/>
                </StackPanel>
                
                <StackPanel>
                    <TextBlock Text="URL:" FontWeight="SemiBold" Foreground="#666" FontSize="12"/>
                    <TextBlock x:Name="UrlText" 
                               Text="" 
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#333"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Download Location -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Download Location:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LocationTextBox" 
                         Grid.Column="0"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"/>
                <Button Grid.Column="1" 
                        Content="Browse..." 
                        Click="BrowseButton_Click"
                        Padding="15,8"/>
            </Grid>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Cancel" 
                    Click="CancelButton_Click"
                    Padding="20,10"
                    MinWidth="100"
                    Margin="0,0,10,0"/>
            <Button Content="Download" 
                    Click="DownloadButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="20,10"
                    MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
