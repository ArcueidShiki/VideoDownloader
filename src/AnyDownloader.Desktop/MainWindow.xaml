<Window x:Class="AnyDownloader.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnyDownloader - Universal Video Downloader"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar with Fluent Design -->
        <Border Grid.Row="0" Background="#0078D4" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📥" FontSize="28" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <StackPanel>
                    <TextBlock Text="AnyDownloader" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Universal Video Downloader" FontSize="12" Foreground="#E0E0E0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel MaxWidth="1000">
                
                <!-- Add Download Card -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Add New Download" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        
                        <TextBox x:Name="UrlTextBox"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 FontSize="14"
                                 Padding="10"
                                 ToolTip="Paste YouTube, TikTok, Bilibili, or magnet link here...">
                        </TextBox>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Quality" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="QualityComboBox" Width="150">
                                    <ComboBoxItem Content="Auto" IsSelected="True"/>
                                    <ComboBoxItem Content="1080p"/>
                                    <ComboBoxItem Content="720p"/>
                                    <ComboBoxItem Content="480p"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Margin="0,0,15,0">
                                <TextBlock Text="Format" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="FormatComboBox" Width="120">
                                    <ComboBoxItem Content="MP4" IsSelected="True"/>
                                    <ComboBoxItem Content="MKV"/>
                                    <ComboBoxItem Content="WebM"/>
                                    <ComboBoxItem Content="MP3"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,10">
                                <CheckBox x:Name="SubtitlesCheckBox" Content="Download Subtitles" FontSize="14"/>
                            </StackPanel>
                            
                            <Button x:Name="AddDownloadButton"
                                    Content="➕ Add Download"
                                    Background="#0078D4"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="20,12"
                                    Margin="20,0,0,0"
                                    Click="AddDownloadButton_Click"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#106EBE"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#005A9E"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Message Bar -->
                <Border x:Name="MessageBar"
                        Background="#107C10"
                        CornerRadius="4"
                        Padding="15"
                        Margin="0,0,0,20"
                        Visibility="Collapsed">
                    <TextBlock x:Name="MessageText" Foreground="White"/>
                </Border>

                <!-- Active Downloads -->
                <TextBlock Text="Active Downloads" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                
                <Border Background="White" CornerRadius="8" Padding="20">
                    <StackPanel x:Name="ActiveDownloadsPanel">
                        <TextBlock x:Name="NoDownloadsText"
                                   Text="No active downloads. Add a URL above to get started!"
                                   Foreground="#666"
                                   HorizontalAlignment="Center"
                                   Margin="20"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
